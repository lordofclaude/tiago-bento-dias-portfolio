---
import { profile } from "../data/profile";
---

<section id="about" class="px-6 py-24">
  <div class="fade-in mx-auto max-w-[1100px]">
    <h2 class="mb-4 text-3xl font-bold text-[#e5e7eb]">About Me</h2>
    <div class="mb-4 h-1 w-16 rounded bg-[#3b82f6]"></div>

    <div class="mb-12 grid gap-12 lg:grid-cols-2">
      <div>
        {
          profile.about.split("\n\n").map((paragraph) => (
            <p class="mb-4 leading-relaxed text-[#9ca3af]">{paragraph}</p>
          ))
        }
      </div>

      <div>
        <h3 class="mb-6 text-lg font-semibold text-[#e5e7eb]">Experience</h3>
        <div class="space-y-6">
          {
            profile.experience.map((job) => (
              <div class="border-l-2 border-[#3b82f6]/40 pl-4">
                <p class="font-medium text-[#e5e7eb]">{job.role}</p>
                <p class="text-[#3b82f6]">{job.company}</p>
                <p class="text-sm text-[#9ca3af]">
                  {job.period} · {job.location}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div>
      <h3 class="mb-6 text-lg font-semibold text-[#e5e7eb]">Education</h3>
      <div class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          profile.education.map((edu) => (
            <div class="rounded-xl border border-white/5 bg-[#111827] p-4">
              <p class="font-medium text-[#e5e7eb]">{edu.degree}</p>
              <p class="text-sm text-[#9ca3af]">{edu.school}</p>
              <p class="mt-1 text-xs text-[#6b7280]">{edu.period}</p>
            </div>
          ))
        }
      </div>

      <div class="flex flex-wrap gap-3">
        {
          profile.certifications.map((cert) => (
            <span
              class:list={[
                "rounded-full px-4 py-1.5 text-sm font-medium",
                cert === "CFA Charterholder"
                  ? "border border-[#d4a853]/40 bg-[#d4a853]/10 text-[#d4a853]"
                  : "border border-white/10 bg-[#111827] text-[#9ca3af]",
              ]}
            >
              {cert}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

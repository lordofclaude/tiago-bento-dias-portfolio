---
import { profile } from "../data/profile";
---

<section
  id="hero"
  class="relative flex min-h-screen items-center justify-center px-6 pt-20"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(59,130,246,0.12)_0%,_transparent_60%)]"
  >
  </div>

  <div class="fade-in relative z-10 mx-auto max-w-[1100px] text-center">
    <p class="mb-4 text-sm font-medium tracking-widest text-[#3b82f6] uppercase">
      Portfolio
    </p>
    <h1 class="mb-6 text-4xl font-bold tracking-tight text-[#e5e7eb] md:text-6xl">
      {profile.name}
    </h1>
    <p class="mx-auto mb-4 max-w-2xl text-xl text-[#9ca3af] md:text-2xl">
      {profile.tagline}
    </p>
    <p class="mb-10 text-[#9ca3af]">
      {profile.role} @ {profile.company} · {profile.location}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="#contact"
        class="rounded-lg bg-[#3b82f6] px-6 py-3 font-medium text-white hover:bg-[#2563eb] transition-colors"
      >
        Get in Touch
      </a>
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-white/10 px-6 py-3 font-medium text-[#e5e7eb] hover:border-[#3b82f6] hover:text-[#3b82f6] transition-colors"
      >
        LinkedIn
      </a>
    </div>
  </div>
</section>

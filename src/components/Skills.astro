---
import { profile } from "../data/profile";
---

<section id="skills" class="px-6 py-24 bg-[#0d0d14]">
  <div class="fade-in mx-auto max-w-[1100px]">
    <h2 class="mb-4 text-3xl font-bold text-[#e5e7eb]">Skills</h2>
    <div class="mb-12 h-1 w-16 rounded bg-[#3b82f6]"></div>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        profile.skills.map((group) => (
          <div class="rounded-xl border border-white/5 bg-[#111827] p-6 transition-colors hover:border-[#3b82f6]/30 hover:bg-[#1a2332]">
            <h3 class="mb-4 text-lg font-semibold text-[#3b82f6]">
              {group.category}
            </h3>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((skill) => (
                <li>
                  <span class="rounded-md bg-[#0a0a0f] px-3 py-1.5 text-sm text-[#9ca3af]">
                    {skill}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
